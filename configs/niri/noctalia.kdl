layout {

    focus-ring {
        active-color   "#ffcea7"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffcea7"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffcea7"
        inactive-color "#f0ae76"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffcea780"
    }
}

recent-windows {
    highlight {
        active-color "#ffcea7"
        urgent-color "#ffb4ab"
    }
}
